<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy-Manifest für FairSeat.

  Apple verlangt diese Datei, seit die "Required Reason APIs" durchgesetzt
  werden. Ohne sie weist App Store Connect den Upload zurück, und zwar erst
  nach der Verarbeitung – der Build ist dann verbrannt und die Build-Nummer
  verbraucht.

  Der Inhalt muss das Verhalten der App tatsächlich abbilden. FairSeat erhebt
  nichts, sendet nichts und trackt nicht; alle Daten bleiben auf dem Gerät.
  Was hier steht, deckt sich damit mit der Datenschutzerklärung und dem
  Data-Safety-Formular bei Google.

  Meldepflichtige Zugriffe:
  - UserDefaults (Cordova legt dort eigene Einstellungen ab). CA92.1 =
    ausschließlich Daten des eigenen App-Containers.
  - Dateizeitstempel und freier Speicher: cordova-plugin-file (kommt mit
    cordova-plugin-advanced-http für den WebDAV-Abgleich). Dessen eigenes
    Manifest ersetzt der iOS-Build durch dieses – darum stehen seine Gründe
    auch hier: C617.1 = Zeitstempel von Dateien im App-Container,
    E174.1 = prüfen, ob genug Platz zum Schreiben ist.

  Der WebDAV-Abgleich sendet eine auf dem Gerät verschlüsselte Datei an einen
  Server, den die Lehrkraft selbst einträgt (z. B. IServ der Schule). Der
  Entwickler erhält nichts – daher bleibt NSPrivacyCollectedDataTypes leer.

  Hinweis zur Pflege: Fremde Plugins bringen eigene Privacy-Manifeste mit.
  Kommt ein Plugin dazu, das eine weitere Required-Reason-API benutzt, gehört
  der Grund entweder hierher oder in das Manifest des Plugins.
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>

    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!-- Leer und bewusst so: Die App sammelt keine Daten. -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>E174.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
